{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcgs/device-library.schema.json",
  "title": "MCGS Device Library",
  "type": "object",
  "required": [
    "id",
    "version",
    "modeling_principle",
    "board_templates",
    "start_box_templates",
    "plug_branch_templates",
    "plug_box_physical_types"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "derived_from": {
      "type": "string"
    },
    "entity_aliases": {
      "type": "object"
    },
    "modeling_principle": {
      "const": "board_is_minimal_protocol_unit"
    },
    "board_templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boardTemplate"
      }
    },
    "secondary_branch_suffix_variants": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "start_box_templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "plug_branch_templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "repeater_templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "single_cabinet_templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "plug_box_physical_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugBoxPhysicalType"
      }
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "required": [
        "id",
        "row_span",
        "register_step",
        "point_prefix_sequence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source_catalog_id": {
          "type": "string"
        },
        "row_span": {
          "type": "integer",
          "minimum": 1
        },
        "register_step": {
          "type": "integer",
          "minimum": 1
        },
        "state_word_mode": {
          "type": "string"
        },
        "point_prefix_sequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "boardTemplate": {
      "type": "object",
      "required": [
        "id",
        "layout_token",
        "phase_mode",
        "branch_capacity",
        "branch_reference_mode"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "layout_token": {
          "type": "string"
        },
        "phase_mode": {
          "enum": [
            "three_phase",
            "single_phase_triplet"
          ]
        },
        "branch_capacity": {
          "type": "integer",
          "minimum": 1
        },
        "branch_reference_mode": {
          "type": "string"
        },
        "secondary_branch_suffix": {
          "type": [
            "string",
            "null"
          ]
        },
        "secondary_branch_suffix_scope": {
          "type": "string"
        },
        "output_phase_sequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "layoutPattern": {
      "type": "object",
      "required": [
        "pattern",
        "tokens",
        "board_count",
        "branch_count",
        "board_template_ids"
      ],
      "properties": {
        "pattern": {
          "type": "string"
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "board_count": {
          "type": "integer",
          "minimum": 1
        },
        "branch_count": {
          "type": "integer",
          "minimum": 1
        },
        "board_template_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "plugBoxPhysicalType": {
      "type": "object",
      "required": [
        "type_code",
        "phase_mode",
        "branch_count",
        "default_layout_pattern",
        "layout_pattern_required",
        "allowed_layout_patterns"
      ],
      "properties": {
        "type_code": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phase_mode": {
          "enum": [
            "three_phase",
            "single_phase_triplet"
          ]
        },
        "branch_count": {
          "type": "integer",
          "minimum": 1
        },
        "default_layout_pattern": {
          "type": "string"
        },
        "layout_pattern_required": {
          "type": "boolean"
        },
        "allowed_layout_patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layoutPattern"
          }
        },
        "authoritative_source": {
          "type": "string"
        },
        "historical_observed": {
          "type": "boolean"
        },
        "historical_evidence": {
          "type": "array"
        },
        "conservative_default_branch_template": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
