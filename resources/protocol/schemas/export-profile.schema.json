{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcgs/export-profile.schema.json",
  "title": "MCGS Export Profiles",
  "type": "object",
  "required": [
    "id",
    "version",
    "profiles"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "family",
          "sheet_order"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "family": {
            "enum": [
              "classic_combined",
              "extended_split",
              "ab_screen_split"
            ]
          },
          "display_label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sheet_order": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "include_summary_sheet": {
            "type": "boolean"
          },
          "merge_start_and_plug": {
            "type": "boolean"
          },
          "split_ab_screens": {
            "type": "boolean"
          },
          "include_single_cabinet_sheet": {
            "type": "boolean"
          },
          "include_repeater_sheet": {
            "type": "boolean"
          },
          "subtype": {
            "type": "string"
          },
          "topology_mode": {
            "type": "string"
          },
          "alarm_mode": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
