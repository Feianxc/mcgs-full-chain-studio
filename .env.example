# Safe local-development defaults. Never place a real password hash here.
PROTOCOL_STUDIO_AUTH_ENABLED=false
PROTOCOL_STUDIO_ADMIN_USERNAME=FEIAN
PROTOCOL_STUDIO_ADMIN_PASSWORD_HASH=
PROTOCOL_STUDIO_ADMIN_FORCE_PASSWORD_CHANGE=true

PROTOCOL_STUDIO_SECURITY_DB=.local/security.sqlite3
PROTOCOL_STUDIO_RUNS_ROOT=.local/runs

PROTOCOL_STUDIO_EXTERNAL_ORIGIN=http://127.0.0.1:8123
PROTOCOL_STUDIO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
PROTOCOL_STUDIO_COOKIE_SECURE=false
PROTOCOL_STUDIO_SESSION_IDLE_SECONDS=43200
PROTOCOL_STUDIO_SESSION_ABSOLUTE_SECONDS=604800
