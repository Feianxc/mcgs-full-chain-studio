{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Feianxc/mcgs-full-chain-studio/schemas/release-manifest.schema.json",
  "title": "MCGS Full-Chain Studio release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "version",
    "created_at",
    "source_date_epoch",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "const": "mcgs-full-chain-studio"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_date_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\](?:[^\\\\]*[^/\\\\])?$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
