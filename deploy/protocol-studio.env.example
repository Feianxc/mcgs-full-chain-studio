# Reference only. Do not overwrite an existing production environment file.
PROTOCOL_STUDIO_AUTH_ENABLED=true
PROTOCOL_STUDIO_ADMIN_USERNAME=FEIAN
PROTOCOL_STUDIO_ADMIN_PASSWORD_HASH=REPLACE_WITH_LOCALLY_GENERATED_SCRYPT_HASH
PROTOCOL_STUDIO_ADMIN_FORCE_PASSWORD_CHANGE=true

PROTOCOL_STUDIO_SECURITY_DB=/srv/apps/protocol-studio/shared/security.sqlite3
PROTOCOL_STUDIO_RUNS_ROOT=/srv/apps/protocol-studio/shared/runs

PROTOCOL_STUDIO_EXTERNAL_ORIGIN=https://protocol.feian.online
PROTOCOL_STUDIO_ALLOWED_HOSTS=protocol.feian.online,127.0.0.1,localhost
PROTOCOL_STUDIO_COOKIE_SECURE=true
PROTOCOL_STUDIO_SESSION_IDLE_SECONDS=43200
PROTOCOL_STUDIO_SESSION_ABSOLUTE_SECONDS=604800
